# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
DB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/collify?retryWrites=true&w=majority

# Cloudinary Credentials for PDF & Material Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Key for AI Quiz Generation
GEMINI_API_KEY=your_gemini_api_key_here
